{
  "name": "react-example",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.js",
    "build": "node node_modules/vite/bin/vite.js build --configLoader runner && node node_modules/vite/bin/vite.js build --ssr server.ts --outDir dist --emptyOutDir false --configLoader runner",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/tsx/dist/cli.mjs src/lib/AbsenceRules.test.ts && node node_modules/tsx/dist/cli.mjs src/lib/RequestApprovalRules.test.ts && node node_modules/tsx/dist/cli.mjs src/lib/LeaveRules.test.ts && node node_modules/tsx/dist/cli.mjs src/lib/LeaveReplenishmentRules.test.ts && node node_modules/tsx/dist/cli.mjs src/lib/EmployeeStatusRules.test.ts && node node_modules/tsx/dist/cli.mjs src/lib/PayrollRules.test.ts && node node_modules/vitest/vitest.mjs run --configLoader runner",
    "coverage": "node node_modules/vitest/vitest.mjs run --coverage --configLoader runner",
    "test:ci": "npm run lint && npm run test && npm run build && npm run coverage",
    "assets:from-favicon": "node scripts/generate-app-icon.mjs",
    "assets:generate": "capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.3",
    "@capacitor/core": "^8.3.3",
    "@google/genai": "^1.52.0",
    "@reduxjs/toolkit": "2.11.2",
    "@sentry/react": "^10.53.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcrypt": "^6.0.0",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-react": "^5.0.4",
    "@vladmandic/human": "^3.3.6",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.9.0",
    "firebase-functions": "^7.2.5",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lightningcss": "1.32.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cron": "^4.2.1",
    "papaparse": "^5.5.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-webcam": "^7.2.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.18",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.5"
  }
}
