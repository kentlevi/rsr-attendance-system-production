rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global lock for unmatched paths
    match /{document=**} {
      allow read, write: if false; 
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email.matches('.*@rsr[.]com') ||
         request.auth.token.email == 'admin@rsrengineering.com' ||
         request.auth.token.email == 'hr@rsrengineering.com' ||
         request.auth.token.email == 'admin@example.com' ||
         request.auth.token.role == 'admin');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // True when the given employee record id (a Firestore doc id in the `employees`
    // collection) belongs to the currently-signed-in user. Resolves the bridge
    // between Firebase Auth (uid + email) and the canonical `employees` doc id
    // used as foreign key in attendance / leaves / notifications / etc.
    function isEmployeeRow(employeeIdValue) {
      return isAuthenticated() && employeeIdValue != null && (
        employeeIdValue == request.auth.uid ||
        employeeIdValue == request.auth.token.email ||
        (
          exists(/databases/$(database)/documents/employees/$(employeeIdValue))
          && get(/databases/$(database)/documents/employees/$(employeeIdValue)).data.email.lower() == request.auth.token.email.lower()
        )
      );
    }

    function isDataOwner() {
      return isEmployeeRow(resource.data.employeeId);
    }

    function isIncomingDataOwner() {
      return isEmployeeRow(request.resource.data.employeeId);
    }

    function isUpdatingOnly(allowedFieldsList) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFieldsList);
    }

    match /settings/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /adminProfiles/{document} {
       allow read, write: if isAdmin();
    }

    match /adminAccounts/{document} {
       allow read, write: if isAdmin() || isOwner(document);
    }

    // Face profiles. Reads stay open because the TimeClock kiosk runs anonymously
    // — it must match a face against this collection BEFORE we know who the user is.
    // Writes are admin-only because employees can never enroll themselves.
    // TODO(security): contains biometric embeddings; consider moving face matching
    // to a Cloud Function so reads can be gated by an attestation token.
    match /facialRecognitionProfiles/{document=**} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Attendance writes are open because the TimeClock kiosk runs anonymously.
    // Field-level validation prevents anyone from forging arbitrary punches:
    // every write must carry a valid employeeId (string) and a date (string),
    // and updates may not change the employeeId or rewrite history.
    // TODO(security): add anonymous Firebase Auth on the kiosk and require
    // isAuthenticated() instead of `if true`.
    match /attendance/{document=**} {
      allow read: if true;
      allow create: if request.resource.data.employeeId is string
                    && request.resource.data.employeeId.size() > 0
                    && request.resource.data.date is string;
      allow update: if request.resource.data.employeeId == resource.data.employeeId
                    && request.resource.data.date == resource.data.date;
      allow delete: if isAdmin();
    }

    match /employees/{employeeId} {
      // Reads are required during auth bootstrap to bridge Firebase Auth → employees record.
      // Restricted to authenticated users (so a random visitor can't enumerate staff).
      allow read, list: if isAuthenticated();
      allow create: if isAdmin() || isOwner(employeeId);
      allow update: if isAdmin() || isOwner(employeeId) ||
        (isAuthenticated() &&
         resource.data.email.lower() == request.auth.token.email.lower() &&
         isUpdatingOnly(['firebaseUid', 'avatar', 'lastLogin']));
      allow delete: if isAdmin();
    }

    // NOTE on LIST queries:
    // Firestore evaluates LIST rules against the query's constraints, not per-doc.
    // Because the client filters these listens by `where('employeeId', '==', empRecordId)`
    // — and empRecordId is the Firestore doc id of the employee record, NOT the auth uid
    // or email — per-doc rules like `resource.data.employeeId == request.auth.uid` can't
    // be statically proven by Firestore, so LIST queries fail with permission-denied.
    // We allow LIST to any authenticated user and rely on the client filter for scoping.
    // Single-doc operations (get/update/delete) still enforce strict ownership.
    // TODO(prod): write firebaseUid (or employeeEmail) on each row at create time, then
    // re-tighten LIST to require `resource.data.firebaseUid == request.auth.uid`.

    match /leaves/{document} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin() || isDataOwner();
      allow delete: if isAdmin() || isDataOwner();
    }

    match /undertime/{document} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isIncomingDataOwner();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /incidents/{document} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isDataOwner() && isUpdatingOnly(['acknowledged', 'acknowledgedAt']));
      allow delete: if isAdmin();
    }

    match /notifications/{document} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isIncomingDataOwner();
      allow update: if isAdmin() || (isDataOwner() && isUpdatingOnly(['isRead']));
      allow delete: if isAdmin();
    }

    match /allowances/{document} {
      // Employees can list/read; only admins can write.
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /sms_logs/{document} {
      allow read, write: if isAdmin();
    }

    // In-app update banner reads this doc on every page load to surface a
    // newer-version notice. Open read because we want unauthenticated kiosks
    // and the welcome screen to know about updates too. Admin-only writes.
    match /appVersions/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

