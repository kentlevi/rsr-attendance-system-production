rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isEmployeeOwner(employeeId) {
      return request.auth != null && request.auth.uid == employeeId;
    }
    
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    match /request-attachments/{employeeId}/{requestType}/{fileName} {
      allow read: if isEmployeeOwner(employeeId) || isAdmin();
      allow write: if (isEmployeeOwner(employeeId) || isAdmin())
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'application/pdf'
        ];
    }
    match /attendance-photos/{employeeId}/{fileName} {
      allow read: if isEmployeeOwner(employeeId) || isAdmin();
      allow write: if (isEmployeeOwner(employeeId) || isAdmin())
        && request.resource.size <= 5 * 1024 * 1024;
    }
  }
}

