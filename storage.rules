rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /request-attachments/{employeeId}/{requestType}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'application/pdf'
        ];
    }
    match /attendance-photos/{employeeId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size <= 5 * 1024 * 1024;
    }
  }
}

